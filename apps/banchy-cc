#!/usr/bin/env python3
# Banchy OS — compact control centre (GTK 4).
#
# Reads ~/.config/banchy/theme.env (generated by 'banchy apply') for the
# current theme / accent / mode and drives the banchy CLI for changes.
# Missing helper commands are reported in the status line, never crash.
import os
import re
import shutil
import subprocess
import sys

try:
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gtk
except Exception as exc:
    sys.stderr.write(
        "banchy-cc: GTK 4 (PyGObject) could not be loaded: {0}\n"
        "  install it with: sudo pacman -S python-gobject gtk4\n".format(exc))
    sys.exit(1)

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
    os.path.expanduser("~"), ".config")
THEME_ENV = os.path.join(XDG_CONFIG, "banchy", "theme.env")
THEME_ROW = re.compile(r"^\s*(?:\*\s+)?([A-Za-z0-9_-]+)\s+\S")


def read_theme_env():
    values = {}
    try:
        with open(THEME_ENV, "r", encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                if key.startswith("BANCHY_"):
                    values[key] = value
    except OSError:
        pass
    return values


def locate(name, *fallback):
    override = os.environ.get(name.upper().replace("-", "_") + "_BIN")
    if override:
        return override
    on_path = shutil.which(name)
    if on_path:
        return on_path
    candidate = os.path.join(REPO_ROOT, *fallback)
    return candidate if os.path.isfile(candidate) else None


BANCHY = locate("banchy", "cli", "banchy")
LOCKER = locate("hyprlock")
POWERMENU = locate("banchy-powermenu", "cli", "bin", "banchy-powermenu")
SETTINGS = locate("banchy-settings", "apps", "banchy-settings")
TERMINAL = locate("kitty")


def banchy(*args):
    if not BANCHY:
        return 127, "", "banchy CLI not found (install Banchy OS or set BANCHY_BIN)"
    try:
        proc = subprocess.run([BANCHY] + list(args),
                              capture_output=True, text=True)
    except OSError as exc:
        return 127, "", str(exc)
    return proc.returncode, proc.stdout, proc.stderr


def parse_theme_list(text):
    """Names plus the active theme from 'banchy theme list'."""
    names = []
    active = None
    for line in text.splitlines():
        match = THEME_ROW.match(line)
        if not match:
            continue
        name = match.group(1)
        if name == "THEME" or not name.strip("-"):
            continue
        names.append(name)
        if line.lstrip().startswith("*"):
            active = name
    return names, active


class ControlCenter(Gtk.ApplicationWindow):

    def __init__(self, application):
        super().__init__(application=application, title="Banchy Control Center",
                         default_width=340)
        self.syncing = False
        self.build_ui()
        self.refresh()

    def build_ui(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                        margin_start=16, margin_end=16, margin_top=16,
                        margin_bottom=16)
        self.theme_label = Gtk.Label(xalign=0)
        self.theme_label.add_css_class("title-2")
        outer.append(self.theme_label)
        self.accent_label = Gtk.Label(xalign=0)
        outer.append(self.accent_label)

        mode_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        mode_label = Gtk.Label(label="Dark mode", xalign=0)
        mode_label.set_hexpand(True)
        mode_row.append(mode_label)
        self.mode_switch = Gtk.Switch()
        self.mode_switch.connect("state-set", self.on_mode_changed)
        mode_row.append(self.mode_switch)
        outer.append(mode_row)

        cycle = Gtk.Button(label="Cycle theme")
        cycle.connect("clicked", self.on_cycle_theme)
        outer.append(cycle)

        grid = Gtk.Grid(column_spacing=8, row_spacing=8, margin_top=6)
        self.buttons = {}
        for index, (key, label) in enumerate(
                (("lock", "Lock"), ("doctor", "Doctor"),
                 ("power", "Power"), ("settings", "Settings"))):
            button = Gtk.Button(label=label)
            button.connect("clicked", self.on_action, key)
            grid.attach(button, index % 2, index // 2, 1, 1)
            self.buttons[key] = button
        outer.append(grid)

        self.status = Gtk.Label(label="", xalign=0, margin_top=6)
        self.status.set_wrap(True)
        outer.append(self.status)
        self.set_child(outer)

    # --- state --------------------------------------------------------------
    def refresh(self):
        values = read_theme_env()
        theme = values.get("BANCHY_THEME") or "no theme applied yet"
        accent = values.get("BANCHY_ACCENT") or ""
        mode = values.get("BANCHY_MODE") or "dark"
        self.theme_label.set_text(theme)
        self.accent_label.set_text(
            "accent {0}".format(accent) if accent else
            "run 'banchy apply' to generate the theme")
        self.syncing = True
        self.mode_switch.set_active(mode != "light")
        self.syncing = False
        for key, path in (("lock", LOCKER), ("power", POWERMENU),
                          ("settings", SETTINGS)):
            available = bool(path)
            self.buttons[key].set_sensitive(available)
            if not available:
                self.buttons[key].set_tooltip_text("{0} not found".format(key))
        if not values and self.status.get_text() == "":
            self.status.set_text("No theme.env yet — run 'banchy apply'.")

    def set_status(self, text):
        self.status.set_text(text)

    # --- actions ------------------------------------------------------------
    def on_mode_changed(self, _switch, state):
        if self.syncing:
            return False
        mode = "dark" if state else "light"
        rc, out, err = banchy("set", "mode", mode)
        if rc == 0:
            rc, out, err = banchy("apply")
        if rc != 0:
            self.syncing = True
            self.mode_switch.set_active(not state)
            self.syncing = False
            self.set_status("mode {0} failed: {1}".format(
                mode, (err or out).strip()))
            return False
        self.set_status("Mode set to {0}.".format(mode))
        self.refresh()
        return False

    def on_cycle_theme(self, _button):
        rc, out, err = banchy("theme", "list")
        if rc != 0:
            self.set_status((err or out).strip())
            return
        names, active = parse_theme_list(out)
        if not names:
            self.set_status("no themes found (banchy theme list)")
            return
        position = names.index(active) if active in names else -1
        target = names[(position + 1) % len(names)]
        rc, out, err = banchy("theme", "set", target)
        if rc != 0:
            self.set_status((err or out).strip())
            return
        self.set_status("Theme set to {0}.".format(target))
        self.refresh()

    def on_action(self, _button, key):
        if key == "lock":
            self.spawn([LOCKER], "Lock")
        elif key == "doctor":
            self.run_doctor()
        elif key == "power":
            self.spawn([POWERMENU], "Power menu")
        elif key == "settings":
            if not SETTINGS:
                self.set_status("banchy-settings not found")
            elif os.access(SETTINGS, os.X_OK):
                self.spawn([SETTINGS], "Settings")
            else:
                self.spawn([sys.executable, SETTINGS], "Settings")

    def run_doctor(self):
        if TERMINAL and BANCHY:
            if self.spawn([TERMINAL, "-e", BANCHY, "doctor"], "Doctor"):
                return
        if not BANCHY:
            self.set_status("banchy CLI not found")
            return
        rc, out, err = banchy("doctor")
        if rc == 127:
            self.set_status((err or out).strip())
            return
        sys.stdout.write(out)
        sys.stdout.flush()
        self.set_status("kitty not found — doctor output printed to stdout.")

    def spawn(self, argv, label):
        if not argv or not argv[0]:
            self.set_status("{0}: command not found".format(label))
            return False
        try:
            subprocess.Popen(argv, start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        except OSError as exc:
            self.set_status("{0}: {1}".format(label, exc))
            return False
        self.set_status("{0} started.".format(label))
        return True


def main():
    app = Gtk.Application(application_id="org.banchy.ControlCenter")

    def on_activate(application):
        ControlCenter(application).present()

    app.connect("activate", on_activate)
    sys.exit(app.run(sys.argv))


if __name__ == "__main__":
    main()
