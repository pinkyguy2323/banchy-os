# Banchy OS — live-ISO-only packages (not installed on the target system).
# Deduplicated against base.list / desktop.list by iso/gen-packages.sh.

# --- CPU microcode -----------------------------------------------------------
# The mkinitcpio 'microcode' hook (see iso/profile/airootfs/etc/mkinitcpio.conf.d/
# archiso.conf, HOOKS copied from archiso releng) embeds these into the initramfs,
# which is why the systemd-boot entries need no separate microcode initrd line.
intel-ucode
amd-ucode

# --- kernel (must always be present on the ISO) ------------------------------
linux

# --- installer / live tooling not needed on the target -----------------------
arch-install-scripts
gptfdisk
parted
efibootmgr
rsync

# --- UEFI boot menu extras (releng ships these; mkarchiso reports them) ------
edk2-shell
memtest86+
memtest86+-efi

# --- initramfs hooks required by HOOKS in airootfs/etc/mkinitcpio.conf.d/ ----
# mkinitcpio-archiso: the archiso/archiso_loop_mnt/archiso_pxe_* hooks (copied
#   from releng) — without it mkinitcpio errors "Hook 'archiso' cannot be
#   found", the initramfs has no root-finding logic and boot dies in emergency
#   shell with "Failed to mount '' on real root".
mkinitcpio-archiso
mkinitcpio-nfs-utils
# syslinux: provides memdiskfind used by the mkinitcpio 'memdisk' hook (releng
#   ships syslinux too).
syslinux
squashfs-tools
