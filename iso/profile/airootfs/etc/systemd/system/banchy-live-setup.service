[Unit]
Description=Banchy OS live session setup
# Live image only (/etc/banchy-live marker ships in the airootfs overlay).
ConditionPathExists=/etc/banchy-live
# Runs before the gettys and the display manager so the live user exists
# when SDDM (autologin) or the serial getty start.
After=local-fs.target
Before=getty@tty1.service serial-getty@ttyS0.service display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/banchy-live-setup.sh

[Install]
WantedBy=multi-user.target
